@{
    ViewData["Title"] = "Attendance Check-In";
    var status = ViewBag.Status as string ?? "Unknown";
    var message = ViewBag.Message as string ?? "";
    var student = ViewBag.Student as SmartAttendanceSystem.Properties.Model.Student;
    var session = ViewBag.Session as SmartAttendanceSystem.Properties.Model.AttendanceSession;
    var recordedAt = ViewBag.RecordedAt as DateTime?;
}

<div class="row justify-content-center align-items-center min-vh-75 py-4">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-xl overflow-hidden" style="border-radius: var(--radius-xl);">
            
            @if (status == "Success")
            {
                <!-- Success Header Banner -->
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); position: relative; overflow: hidden;">
                    <div style="position: absolute; top: -40px; right: -40px; width: 150px; height: 150px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);"></div>
                    <div style="position: relative; z-index: 2;">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-success shadow-lg mb-3" style="width: 76px; height: 76px; font-size: 2.5rem;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <h3 class="fw-bold mb-1">Attendance Confirmed!</h3>
                        <p class="mb-0 text-white-50 small">Your presence has been officially recorded</p>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light mb-4 border">
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(student?.FaceImagePath))
                            {
                                <img src="@student.FaceImagePath" alt="@student.Name" class="rounded-circle border border-2 border-white shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="user-avatar-bubble" style="width: 48px; height: 48px; font-size: 1.1rem;">
                                    @(student?.Name?.Substring(0, 1).ToUpper() ?? "S")
                                </div>
                            }
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@student?.Name</h6>
                                <small class="text-muted">ID: @student?.EnrollmentNumber</small>
                            </div>
                        </div>
                        <span class="badge badge-soft-success badge-pill py-2 px-3">
                            <i class="bi bi-patch-check-fill me-1"></i> PRESENT
                        </span>
                    </div>

                    <div class="list-group list-group-flush border rounded-3 mb-4 overflow-hidden">
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted small"><i class="bi bi-book me-2 text-primary"></i>Subject</span>
                            <span class="fw-semibold text-dark">@(session?.Subject ?? "Class Lecture")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted small"><i class="bi bi-mortarboard me-2 text-primary"></i>Class / Cohort</span>
                            <span class="fw-semibold text-dark">@(session?.Class?.Name ?? student?.SchoolClass?.Name ?? "Academic Class")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted small"><i class="bi bi-clock-history me-2 text-primary"></i>Recorded Time</span>
                            <span class="fw-semibold text-dark">@(recordedAt?.ToLocalTime().ToString("hh:mm tt &bull; MMM dd, yyyy") ?? DateTime.Now.ToString("hh:mm tt"))</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted small"><i class="bi bi-qr-code-scan me-2 text-primary"></i>Method</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">QR Dynamic Check-in</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-primary py-2 fw-semibold">
                            <i class="bi bi-speedometer2 me-2"></i> Go to Student Dashboard
                        </a>
                        <a asp-controller="Student" asp-action="MyAttendance" class="btn btn-outline-secondary py-2">
                            <i class="bi bi-calendar-check me-2"></i> View My Attendance History
                        </a>
                    </div>
                </div>
            }
            else if (status == "AlreadyRecorded")
            {
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-primary shadow-lg mb-3" style="width: 76px; height: 76px; font-size: 2.5rem;">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Already Recorded</h3>
                    <p class="mb-0 text-white-50 small">You are already checked in for today</p>
                </div>

                <div class="card-body p-4 p-md-5 text-center">
                    <p class="text-muted mb-4 fs-6">
                        @message
                    </p>
                    @if (recordedAt.HasValue)
                    {
                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <small class="text-muted d-block mb-1">Today's Check-in Timestamp</small>
                            <span class="fw-bold text-dark fs-5">@recordedAt.Value.ToLocalTime().ToString("hh:mm:ss tt &bull; MMMM dd, yyyy")</span>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-primary py-2">
                            <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-danger shadow-lg mb-3" style="width: 76px; height: 76px; font-size: 2.5rem;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Check-in Unavailable</h3>
                    <p class="mb-0 text-white-50 small">Unable to record attendance session</p>
                </div>

                <div class="card-body p-4 p-md-5 text-center">
                    <div class="alert alert-danger border-0 rounded-3 mb-4">
                        @message
                    </div>

                    <p class="text-muted small mb-4">
                        If you believe this is in error, please ask your instructor to verify the session or contact system administration.
                    </p>

                    <div class="d-grid gap-2">
                        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-secondary py-2">
                            <i class="bi bi-house-door me-2"></i> Return to Portal Home
                        </a>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
