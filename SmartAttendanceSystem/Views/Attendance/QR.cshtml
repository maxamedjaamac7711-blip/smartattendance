@model SmartAttendanceSystem.Properties.Model.AttendanceSession

@{
    ViewData["Title"] = "Attendance QR Code";
}

<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-ghost btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="page-title mb-0">Attendance QR Code</h1>
            <p class="text-muted mb-0 small">Students scan to mark attendance</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">

        <!-- Session Info Bar -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body py-3 px-4">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon" style="background:var(--primary-gradient); width:42px; height:42px; font-size:1rem;">
                                <i class="bi bi-mortarboard"></i>
                            </div>
                            <div>
                                <div class="fw-semibold">@(Model.Class?.Name ?? "Class")</div>
                                <small class="text-muted">@(Model.Subject ?? "Attendance Session")</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-success-subtle text-success px-3 py-2 fs-6" id="sessionStatus">
                            <i class="bi bi-dot"></i>Live Session
                        </span>
                    </div>
                    <div class="col-auto text-end">
                        <div class="text-muted small">Expires</div>
                        <div class="fw-semibold" id="expiryDisplay">
                            @Model.ExpiresAt.ToLocalTime().ToString("HH:mm")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- QR Display -->
        @if (ViewBag.CheckUrl != null)
        {
            var url = ViewBag.CheckUrl as string;
            var qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=350x350&margin=20&data=" + System.Net.WebUtility.UrlEncode(url);

            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <div class="d-inline-block p-3 rounded-4 bg-white shadow" style="border: 4px solid #f3f4f6;">
                            <img src="@qrUrl" alt="Attendance QR Code" class="img-fluid"
                                 style="max-width:300px; border-radius:8px;" />
                        </div>
                    </div>

                    <h4 class="fw-bold mb-2">Scan to Mark Attendance</h4>
                    <p class="text-muted mb-4">
                        Open your camera app and point it at the QR code above
                    </p>

                    <!-- Countdown Timer -->
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center gap-2 px-4 py-2 rounded-pill"
                             style="background:rgba(99,102,241,.1);">
                            <i class="bi bi-clock text-primary"></i>
                            <span class="text-primary fw-semibold" id="countdown">Calculating...</span>
                        </div>
                    </div>

                    <!-- URL Reference -->
                    <div class="bg-light rounded-3 p-3 text-start mb-4">
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-link-45deg me-1"></i>Direct attendance link:
                        </small>
                        <code class="small text-break">@url</code>
                    </div>

                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a asp-action="ClassAttendance" asp-route-classId="@Model.ClassId"
                           class="btn btn-primary">
                            <i class="bi bi-people me-2"></i>View Attendance
                        </a>
                        <button onclick="window.print()" class="btn btn-ghost">
                            <i class="bi bi-printer me-2"></i>Print QR
                        </button>
                        <a asp-action="Index" class="btn btn-ghost">
                            <i class="bi bi-arrow-left me-2"></i>All Sessions
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm text-center p-5">
                <div class="text-muted mb-3" style="font-size:3rem;">⚠️</div>
                <h5 class="fw-semibold">No QR Code Available</h5>
                <p class="text-muted">The session URL could not be generated.</p>
                <a asp-action="Index" class="btn btn-primary btn-sm">Back to Sessions</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const expiresAt = new Date('@Model.ExpiresAt.ToString("O")');

        function updateCountdown() {
            const now = new Date();
            const diff = Math.floor((expiresAt - now) / 1000);

            if (diff <= 0) {
                document.getElementById('countdown').textContent = 'Session expired';
                document.getElementById('sessionStatus').innerHTML = '<i class="bi bi-x-circle"></i> Expired';
                document.getElementById('sessionStatus').className = 'badge bg-danger-subtle text-danger px-3 py-2 fs-6';
                return;
            }

            const m = Math.floor(diff / 60);
            const s = diff % 60;
            document.getElementById('countdown').textContent =
                `${m}m ${s.toString().padStart(2, '0')}s remaining`;

            if (diff < 120) {
                document.getElementById('countdown').className = 'text-danger fw-semibold';
            }
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    </script>
}
