@model SmartAttendanceSystem.Properties.Model.SchoolClass

@{
    ViewData["Title"] = "Create Class";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Create Academic Class</h2>
                <p class="text-muted small mb-0">Define class cohort and assign to faculty department</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Classes
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="alert alert-danger rounded-3 small py-2 mb-4" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Class Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Computer Science - Year 3" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="FacultyId" class="form-label">Faculty Department</label>
                        <select asp-for="FacultyId" class="form-select" asp-items="ViewBag.Faculties" required>
                            <option value="">-- Select Faculty Department --</option>
                        </select>
                        <span asp-validation-for="FacultyId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle"></i> Create Class
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
