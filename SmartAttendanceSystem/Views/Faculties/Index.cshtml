@model IEnumerable<SmartAttendanceSystem.Properties.Model.Faculty>

@{
    ViewData["Title"] = "Faculties & Departments";
    var faculties = Model.ToList();
    var classCounts = ViewBag.ClassCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var studentCounts = ViewBag.StudentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">Faculties & Departments</h2>
            <span class="badge badge-soft-primary badge-pill">@faculties.Count Divisions</span>
        </div>
        <p class="text-muted small mb-0 mt-1">Manage university faculties and departmental subdivisions</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Faculty
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header card-header-clean d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0 fw-bold">Active Faculties</h5>
        <div class="d-flex align-items-center gap-2">
            <input type="text" id="facultySearch" class="form-control form-control-sm" placeholder="Search faculty name..." style="width: 250px;" />
        </div>
    </div>
    <div class="card-body p-0">
        @if (faculties.Any())
        {
            <div class="table-responsive">
                <table class="table table-modern" id="facultiesTable">
                    <thead>
                        <tr>
                            <th>Faculty Name</th>
                            <th>Description</th>
                            <th>Classes</th>
                            <th>Enrolled Students</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in faculties)
                        {
                            var cCount = classCounts.ContainsKey(f.Id) ? classCounts[f.Id] : 0;
                            var sCount = studentCounts.ContainsKey(f.Id) ? studentCounts[f.Id] : 0;

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="stat-icon bg-warning-subtle text-warning" style="width: 38px; height: 38px; font-size: 1.1rem;">
                                            <i class="bi bi-journal-bookmark"></i>
                                        </div>
                                        <div class="fw-bold text-dark">@f.Name</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(f.Description) ? "No description provided." : f.Description)</span>
                                </td>
                                <td>
                                    <span class="badge badge-soft-dark badge-pill">@cCount Classes</span>
                                </td>
                                <td>
                                    <span class="badge badge-soft-info badge-pill">@sCount Students</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary" title="Edit Faculty">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="d-inline" onsubmit="return confirm('Delete faculty @f.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-bookmark fs-1 d-block mb-2"></i>
                <h6>No faculties registered yet.</h6>
                <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
                    <i class="bi bi-plus-circle"></i> Add First Faculty
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('facultySearch')?.addEventListener('keyup', function () {
            const query = this.value.toLowerCase();
            const rows = document.querySelectorAll('#facultiesTable tbody tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    </script>
}
