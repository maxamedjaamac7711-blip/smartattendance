@model SmartAttendanceSystem.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    var todayStr = DateTime.Now.ToString("dddd, MMMM dd, yyyy");
}

<!-- Hero Welcome Section -->
<div class="hero-gradient-banner mb-4">
    <div class="hero-glow-circle"></div>
    <div class="row align-items-center g-3" style="position: relative; z-index: 2;">
        <div class="col-lg-8">
            <div class="d-inline-flex align-items-center gap-2 mb-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-15">
                <span class="pulse-indicator"></span>
                <span class="small fw-semibold text-white">System Live &bull; @todayStr</span>
            </div>
            <h1 class="display-6 fw-bold text-white mb-2">Smart Attendance Command Center</h1>
            <p class="lead text-white-50 fs-6 mb-0" style="max-width: 650px;">
                Real-time institutional oversight across student biometric enrollments, live attendance sessions, and predictive analytics.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <div class="d-flex gap-2 justify-content-lg-end flex-wrap">
                <a asp-controller="Attendance" asp-action="Start" class="btn btn-primary px-3 py-2 shadow">
                    <i class="bi bi-play-circle-fill"></i> Launch Session
                </a>
                <a asp-controller="Student" asp-action="Create" class="btn btn-light px-3 py-2 shadow-sm text-dark">
                    <i class="bi bi-person-plus-fill"></i> Add Student
                </a>
            </div>
        </div>
    </div>
</div>

<!-- 4 Key Metric Stat Cards -->
<div class="row g-3 mb-4">
    <!-- Total Students -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="stat-label">Total Students</div>
                    <div class="stat-number">@Model.TotalStudents</div>
                </div>
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                <span class="badge badge-soft-primary badge-pill">
                    <i class="bi bi-camera"></i> @Model.FaceEnrolledStudentsCount Enrolled
                </span>
                <small class="text-muted">Face Biometrics</small>
            </div>
        </div>
    </div>

    <!-- Today's Attendance -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="stat-label">Today's Present</div>
                    <div class="stat-number text-success">@Model.TodayAttendanceCount</div>
                </div>
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                <span class="badge badge-soft-success badge-pill">
                    <i class="bi bi-graph-up"></i> @Model.TodayAttendanceRate%
                </span>
                <small class="text-muted">Attendance Rate</small>
            </div>
        </div>
    </div>

    <!-- Active Sessions -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="stat-label">Active Sessions</div>
                    <div class="stat-number text-primary">@Model.ActiveSessionsCount</div>
                </div>
                <div class="stat-icon bg-info-subtle text-info">
                    <i class="bi bi-broadcast"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                @if (Model.ActiveSessionsCount > 0)
                {
                    <span class="badge badge-soft-danger badge-pill">
                        <span class="pulse-indicator me-1"></span> LIVE NOW
                    </span>
                    <small class="text-muted">In Progress</small>
                }
                else
                {
                    <span class="badge badge-soft-dark badge-pill">Idle</span>
                    <small class="text-muted">No live sessions</small>
                }
            </div>
        </div>
    </div>

    <!-- Faculties & Classes -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="stat-label">Classes & Faculties</div>
                    <div class="stat-number text-dark">@Model.TotalClasses</div>
                </div>
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-building"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                <span class="badge badge-soft-warning badge-pill">
                    @Model.TotalFaculties Faculties
                </span>
                <small class="text-muted">&bull; @Model.TotalTeachers Teachers</small>
            </div>
        </div>
    </div>
</div>

<!-- Active Sessions Live Alert Banner (if any) -->
@if (Model.ActiveSessions.Any())
{
    <div class="card border-primary border-opacity-25 shadow-sm mb-4" style="background: linear-gradient(to right, #eff6ff, #f8fafc);">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary text-white shadow-sm">
                        <i class="bi bi-broadcast-pin fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0 fw-bold">Live Attendance Sessions Active</h5>
                            <span class="badge badge-soft-danger badge-pill">
                                <span class="pulse-indicator me-1"></span> Real-time
                            </span>
                        </div>
                        <p class="text-muted small mb-0 mt-1">Students are actively scanning QR or submitting biometrics</p>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var s in Model.ActiveSessions.Take(2))
                    {
                        <a asp-controller="Attendance" asp-action="QR" asp-route-id="@s.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-qr-code"></i> @(s.Subject ?? "Class") (@(s.Class?.Name ?? "Class"))
                        </a>
                    }
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-primary btn-sm">
                        View All <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Recent Attendance Activity Stream -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold">Recent Attendance Stream</h5>
                    <small class="text-muted">Live biometric and QR scan logs</small>
                </div>
                <a asp-controller="Attendance" asp-action="Report" class="btn btn-soft-primary btn-sm">
                    Detailed Report <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentAttendances.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-modern">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Class & Subject</th>
                                    <th>Method</th>
                                    <th>Timestamp</th>
                                    <th class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RecentAttendances)
                                {
                                    var initial = item.StudentName.Length > 0 ? item.StudentName.Substring(0, 1).ToUpper() : "S";
                                    var isFace = item.Method == "Face";
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(item.FaceImagePath))
                                                {
                                                    <img src="@Url.Action("FaceImage", "Student", new { id = item.StudentId })" alt="@item.StudentName" class="rounded-circle border" style="width: 34px; height: 34px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="user-avatar-bubble" style="width: 34px; height: 34px; font-size: 0.85rem;">
                                                        @initial
                                                    </div>
                                                }
                                                <div>
                                                    <div class="fw-semibold text-dark">@item.StudentName</div>
                                                    <small class="text-muted">ID: @item.EnrollmentNumber</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-medium text-dark">@item.ClassName</div>
                                            <small class="text-muted">@item.Subject</small>
                                        </td>
                                        <td>
                                            @if (isFace)
                                            {
                                                <span class="badge badge-soft-info badge-pill">
                                                    <i class="bi bi-camera-fill"></i> Face AI
                                                </span>
                                            }
                                            else if (item.Method == "Manual")
                                            {
                                                <span class="badge badge-soft-dark badge-pill">
                                                    <i class="bi bi-person-check"></i> Manual
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-primary badge-pill">
                                                    <i class="bi bi-qr-code"></i> QR Code
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="small fw-medium text-dark">@item.AttendanceDate.ToLocalTime().ToString("hh:mm tt")</div>
                                            <small class="text-muted">@item.AttendanceDate.ToLocalTime().ToString("MMM dd")</small>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge badge-soft-success badge-pill">
                                                <i class="bi bi-check2"></i> Present
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="display-4 text-muted mb-3"><i class="bi bi-clock-history"></i></div>
                        <h6 class="fw-bold">No Attendance Records Today</h6>
                        <p class="text-muted small mb-3">Launch a session to start tracking student check-ins.</p>
                        <a asp-controller="Attendance" asp-action="Start" class="btn btn-primary btn-sm">
                            <i class="bi bi-play-fill"></i> Start New Session
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Management Hub -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-clean">
                <h5 class="mb-0 fw-bold">Management Hub</h5>
                <small class="text-muted">Administrative tools & directories</small>
            </div>
            <div class="card-body p-3 d-flex flex-column gap-2">
                <a asp-controller="Student" asp-action="Index" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-primary-subtle text-primary" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-mortarboard"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Students Directory</div>
                                <small class="text-muted">@Model.TotalStudents total &bull; Profiles & Faces</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-controller="Teachers" asp-action="Index" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-success-subtle text-success" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-person-video3"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Faculty Teachers</div>
                                <small class="text-muted">@Model.TotalTeachers registered instructors</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-controller="Classes" asp-action="Index" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-info-subtle text-info" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-building"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Academic Classes</div>
                                <small class="text-muted">@Model.TotalClasses enrolled cohorts</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-controller="Faculties" asp-action="Index" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-warning-subtle text-warning" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-journal-bookmark"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Departments & Faculties</div>
                                <small class="text-muted">@Model.TotalFaculties institutional divisions</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-controller="Attendance" asp-action="Report" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-danger-subtle text-danger" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Analytics & Reports</div>
                                <small class="text-muted">Trend charts & CSV data export</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
