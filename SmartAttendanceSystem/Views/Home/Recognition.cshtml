@{
    ViewData["Title"] = "Recognition";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h1 class="mb-3">Face Recognition</h1>
        <p class="text-secondary">This screen is ready for integrating a camera feed, face detection, and attendance capture logic.</p>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="border rounded-4 bg-dark d-flex align-items-center justify-content-center text-white" style="min-height: 420px;">
                    <div class="text-center">
                        <div class="display-1">📷</div>
                        <div class="mt-3 fw-semibold">Camera Preview</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 bg-light h-100">
                    <div class="card-body">
                        <h5 class="card-title">Live Detection</h5>
                        <ul class="list-group list-group-flush mt-3">
                            <li class="list-group-item">Face detected: 1</li>
                            <li class="list-group-item">Confidence: 98.7%</li>
                            <li class="list-group-item">Status: Ready</li>
                        </ul>
                        <button class="btn btn-primary w-100 mt-4">Mark Attendance</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
