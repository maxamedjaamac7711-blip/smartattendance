@model SmartAttendanceSystem.Models.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Portal";
    var initial = Model.Student.Name.Length > 0 ? Model.Student.Name.Substring(0, 1).ToUpper() : "S";
}

<!-- Student Profile Hero Section -->
<div class="card border-0 shadow-lg mb-4 overflow-hidden" style="background: var(--gradient-dark); border-radius: var(--radius-xl); color: white; position: relative;">
    <div class="hero-glow-circle"></div>
    <div class="card-body p-4 p-md-5" style="position: relative; z-index: 2;">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (!string.IsNullOrEmpty(Model.Student.FaceImagePath))
                    {
                        <img src="@Url.Action("FaceImage", "Student", new { id = Model.Student.StudentID })" alt="@Model.Student.Name" class="rounded-circle border border-2 border-white shadow" style="width: 72px; height: 72px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="user-avatar-bubble avatar-lg border border-2 border-white shadow">
                            @initial
                        </div>
                    }
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h2 class="display-6 fw-bold text-white mb-0">@Model.Student.Name</h2>
                            @if (Model.HasFaceEnrollment)
                            {
                                <span class="badge badge-soft-success badge-pill">
                                    <i class="bi bi-shield-check"></i> Face Verified
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-warning badge-pill">
                                    <i class="bi bi-exclamation-triangle"></i> Face Not Enrolled
                                </span>
                            }
                        </div>
                        <div class="text-white-50 mt-1">
                            <span class="fw-semibold text-white">ID: @Model.Student.EnrollmentNumber</span> &bull; 
                            @(Model.Student.Faculty?.Name ?? "Faculty") &bull; 
                            @(Model.Student.SchoolClass?.Name ?? "Class Cohort")
                        </div>
                    </div>
                </div>

                @if (!Model.HasFaceEnrollment)
                {
                    <div class="alert alert-warning border-0 rounded-4 p-3 d-flex align-items-center justify-content-between flex-wrap gap-2 mb-0" style="background: rgba(245, 158, 11, 0.2); backdrop-filter: blur(10px); border: 1px solid rgba(245, 158, 11, 0.4) !important;">
                        <div class="d-flex align-items-center gap-2 text-white">
                            <i class="bi bi-camera fs-4 text-warning"></i>
                            <div>
                                <strong class="text-white">Face Biometrics Not Enrolled:</strong>
                                <span class="text-white-50">Enroll your face to enable instant contactless AI check-ins.</span>
                            </div>
                        </div>
                        <a asp-action="FaceEnrollment" asp-route-id="@Model.Student.StudentID" class="btn btn-warning btn-sm fw-bold">
                            <i class="bi bi-camera"></i> Enroll Face Now
                        </a>
                    </div>
                }
            </div>

            <div class="col-md-4 text-md-end">
                <div class="p-3 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-15 text-center d-inline-block" style="min-width: 180px;">
                    <div class="text-white-50 small text-uppercase fw-bold">Attendance Rate</div>
                    <div class="display-5 fw-bold text-white my-1">@Model.OverallAttendanceRate%</div>
                    <span class="badge badge-soft-success badge-pill">
                        @Model.TotalAttendedSessions of @Model.TotalClassSessions Sessions
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Today's Attendance Status Banner -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    @if (Model.IsPresentToday)
                    {
                        <div class="stat-icon bg-success text-white shadow-sm" style="width: 56px; height: 56px;">
                            <i class="bi bi-check-circle-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="badge badge-soft-success badge-pill mb-1">RECORDED TODAY</span>
                            <h4 class="fw-bold mb-1">You're Present Today! 🎉</h4>
                            <p class="text-muted small mb-0">
                                Marked via <strong>@(Model.TodayCheckInMethod ?? "Session")</strong> at @(Model.TodayCheckInTime?.ToLocalTime().ToString("hh:mm tt") ?? "Class")
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="stat-icon bg-warning text-white shadow-sm" style="width: 56px; height: 56px;">
                            <i class="bi bi-hourglass-split fs-3"></i>
                        </div>
                        <div>
                            <span class="badge badge-soft-warning badge-pill mb-1">NOT CHECKED IN YET</span>
                            <h4 class="fw-bold mb-1">Ready for Attendance</h4>
                            <p class="text-muted small mb-0">Mark your attendance using Face AI or scanning class QR</p>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="FaceCheckIn" class="btn btn-primary">
                        <i class="bi bi-camera"></i> Face Check-in
                    </a>
                    <a asp-action="ScanQR" class="btn btn-outline-primary">
                        <i class="bi bi-qr-code-scan"></i> Scan QR
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Sessions in Class -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0 fw-bold">Active Classroom Sessions</h5>
                    @if (Model.ActiveSessionsForClass.Any())
                    {
                        <span class="badge badge-soft-danger badge-pill">
                            <span class="pulse-indicator me-1"></span> LIVE NOW
                        </span>
                    }
                </div>
                <small class="text-muted">@(Model.Student.SchoolClass?.Name ?? "Your Class")</small>
            </div>
            <div class="card-body p-3">
                @if (Model.ActiveSessionsForClass.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var s in Model.ActiveSessionsForClass)
                        {
                            <div class="p-3 rounded-3 border bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div class="fw-bold text-dark">@(s.Subject ?? "Class Attendance")</div>
                                    <small class="text-muted">
                                        <i class="bi bi-clock"></i> Expires: @s.ExpiresAt.ToLocalTime().ToString("hh:mm tt")
                                    </small>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="FaceCheckIn" class="btn btn-sm btn-primary">
                                        <i class="bi bi-camera"></i> Check-in Now
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <i class="bi bi-check2-circle fs-3 text-success d-block mb-1"></i>
                        <span class="small">No active sessions right now. Your teacher will open one during lecture.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Quick Navigation & Recent Attendance -->
<div class="row g-4">
    <!-- Student Quick Shortcuts -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-clean">
                <h5 class="mb-0 fw-bold">Student Services</h5>
                <small class="text-muted">Your academic records & tools</small>
            </div>
            <div class="card-body p-3 d-flex flex-column gap-2">
                <a asp-action="MyAttendance" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-success-subtle text-success" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Attendance History</div>
                                <small class="text-muted">Full logs & session breakdown</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-action="MyProfile" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-primary-subtle text-primary" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Digital Student ID</div>
                                <small class="text-muted">Institutional card with barcode</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-action="MyClass" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-info-subtle text-info" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-people"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Class Directory</div>
                                <small class="text-muted">View classmates in cohort</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-action="FaceEnrollment" asp-route-id="@Model.Student.StudentID" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-warning-subtle text-warning" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-camera"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Face Biometrics Setup</div>
                                <small class="text-muted">Update or re-enroll facial data</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Check-in Logs -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold">Recent Check-in Logs</h5>
                    <small class="text-muted">Your verified attendance entries</small>
                </div>
                <a asp-action="MyAttendance" class="btn btn-soft-primary btn-sm">
                    View Complete History <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentAttendances.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-modern">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Subject / Session</th>
                                    <th>Method</th>
                                    <th class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var att in Model.RecentAttendances)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@att.AttendanceDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">@att.AttendanceDate.ToLocalTime().ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            <div class="fw-medium text-dark">@(att.Subject ?? "Lecture Session")</div>
                                        </td>
                                        <td>
                                            @if (att.Method == "Face")
                                            {
                                                <span class="badge badge-soft-info badge-pill">
                                                    <i class="bi bi-camera-fill"></i> Face AI
                                                </span>
                                            }
                                            else if (att.Method == "Manual")
                                            {
                                                <span class="badge badge-soft-dark badge-pill">
                                                    <i class="bi bi-person-check"></i> Manual
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-primary badge-pill">
                                                    <i class="bi bi-qr-code"></i> QR Code
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <span class="badge badge-soft-success badge-pill">
                                                <i class="bi bi-check2"></i> Present
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 text-muted d-block mb-2"></i>
                        <h6>No Attendance History Recorded Yet</h6>
                        <small>When you scan QR or use Face check-in, your sessions will appear here.</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
