@model SmartAttendanceSystem.Models.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Instructor Workspace";
    var initial = Model.Teacher.Name.Length > 0 ? Model.Teacher.Name.Substring(0, 1).ToUpper() : "T";
    var todayStr = DateTime.Now.ToString("dddd, MMMM dd, yyyy");
}

<!-- Teacher Hero Banner -->
<div class="hero-gradient-banner mb-4">
    <div class="hero-glow-circle"></div>
    <div class="row align-items-center g-3" style="position: relative; z-index: 2;">
        <div class="col-lg-8">
            <div class="d-inline-flex align-items-center gap-2 mb-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-15">
                <span class="pulse-indicator"></span>
                <span class="small fw-semibold text-white">Faculty Instructor Portal &bull; @todayStr</span>
            </div>
            <div class="d-flex align-items-center gap-3 mt-1">
                <div class="user-avatar-bubble avatar-lg border border-2 border-white shadow">
                    @initial
                </div>
                <div>
                    <h2 class="display-6 fw-bold text-white mb-1">Welcome, @Model.Teacher.Name</h2>
                    <p class="lead text-white-50 fs-6 mb-0">
                        Assigned Class: <strong class="text-white">@(Model.Teacher.SchoolClass?.Name ?? "General Cohort")</strong> &bull; 
                        Department: <strong class="text-white">@(Model.Teacher.Faculty?.Name ?? "Academic Faculty")</strong>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 text-lg-end">
            <div class="d-flex gap-2 justify-content-lg-end flex-wrap">
                <a asp-controller="Attendance" asp-action="Start" class="btn btn-primary px-3 py-2 shadow">
                    <i class="bi bi-qr-code"></i> Start QR Session
                </a>
                <a asp-controller="Attendance" asp-action="Start" asp-route-method="Face" class="btn btn-danger px-3 py-2 shadow">
                    <i class="bi bi-camera"></i> Start Face AI
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Key Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="stat-label">Class Students</div>
                    <div class="stat-number">@Model.TotalStudentsInClass</div>
                </div>
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                <a asp-action="MyStudents" class="small text-primary fw-semibold text-decoration-none">
                    View Class Roster <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="stat-label">Today's Attendance</div>
                    <div class="stat-number text-success">@Model.TodayPresentCount</div>
                </div>
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                <span class="badge badge-soft-success badge-pill">@Model.TodayAttendanceRate% Present</span>
                <small class="text-muted">Today's class turn-out</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="stat-label">Face AI Enrolled</div>
                    <div class="stat-number text-info">@Model.FaceEnrolledCount</div>
                </div>
                <div class="stat-icon bg-info-subtle text-info">
                    <i class="bi bi-camera-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                <small class="text-muted">Out of @Model.TotalStudentsInClass students in your cohort</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="stat-label">Active Sessions</div>
                    <div class="stat-number text-primary">@Model.ActiveSessions.Count</div>
                </div>
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-broadcast"></i>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                @if (Model.ActiveSessions.Any())
                {
                    <span class="badge badge-soft-danger badge-pill">
                        <span class="pulse-indicator me-1"></span> LIVE NOW
                    </span>
                }
                else
                {
                    <span class="badge badge-soft-dark badge-pill">Standby</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Active Live Sessions Banner -->
@if (Model.ActiveSessions.Any())
{
    <div class="card border-primary border-opacity-25 shadow-sm mb-4" style="background: linear-gradient(to right, #eff6ff, #f8fafc);">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary text-white shadow-sm">
                        <i class="bi bi-broadcast-pin fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0 fw-bold">Live Session In Progress</h5>
                            <span class="badge badge-soft-danger badge-pill">
                                <span class="pulse-indicator me-1"></span> Active
                            </span>
                        </div>
                        <p class="text-muted small mb-0 mt-1">Students can scan QR or use facial recognition right now</p>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var session in Model.ActiveSessions)
                    {
                        <a asp-controller="Attendance" asp-action="QR" asp-route-id="@session.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-qr-code"></i> Show QR Screen (@session.Subject)
                        </a>
                        <a asp-controller="Attendance" asp-action="ClassAttendance" asp-route-classId="@session.ClassId" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-list-check"></i> Roll Call Sheet
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Recent Sessions & Quick Access -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold">Recent Attendance Sessions</h5>
                    <small class="text-muted">Attendance batches conducted for your class</small>
                </div>
                <a asp-controller="Attendance" asp-action="Index" class="btn btn-soft-primary btn-sm">
                    All Sessions <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentSessions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-modern">
                            <thead>
                                <tr>
                                    <th>Subject / Topic</th>
                                    <th>Started</th>
                                    <th>Expires</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.RecentSessions)
                                {
                                    var isActive = s.IsActive && s.ExpiresAt > DateTime.UtcNow;
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@(s.Subject ?? "Lecture Session")</div>
                                            <small class="text-muted">Token: <code class="small text-muted">@s.Token.Substring(0, Math.Min(8, s.Token.Length))...</code></small>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-dark">@s.CreatedAt.ToLocalTime().ToString("MMM dd")</div>
                                            <small class="text-muted">@s.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            <small class="text-muted">@s.ExpiresAt.ToLocalTime().ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            @if (isActive)
                                            {
                                                <span class="badge badge-soft-success badge-pill">
                                                    <span class="pulse-indicator me-1"></span> Live
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-dark badge-pill">Ended</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-controller="Attendance" asp-action="QR" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary" title="View QR">
                                                    <i class="bi bi-qr-code"></i>
                                                </a>
                                                <a asp-controller="Attendance" asp-action="ClassAttendance" asp-route-classId="@s.ClassId" class="btn btn-sm btn-outline-primary" title="Roll Call">
                                                    <i class="bi bi-list-check"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-clock-history fs-1 d-block mb-2"></i>
                        <h6>No attendance sessions created yet.</h6>
                        <a asp-controller="Attendance" asp-action="Start" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-play-circle"></i> Start First Session
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Tools Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-clean">
                <h5 class="mb-0 fw-bold">Class Actions</h5>
                <small class="text-muted">Direct instructor controls</small>
            </div>
            <div class="card-body p-3 d-flex flex-column gap-2">
                <a asp-action="MyStudents" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-primary-subtle text-primary" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-people"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Class Roster</div>
                                <small class="text-muted">@Model.TotalStudentsInClass students in cohort</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-controller="Attendance" asp-action="ClassAttendance" asp-route-classId="@Model.Teacher.ClassId" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-success-subtle text-success" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-check2-square"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Today's Roll Call</div>
                                <small class="text-muted">Mark manual attendance override</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>

                <a asp-controller="Attendance" asp-action="Report" class="card card-hover p-3 text-decoration-none border">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-info-subtle text-info" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Attendance Analytics</div>
                                <small class="text-muted">View graphs & export CSV data</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
