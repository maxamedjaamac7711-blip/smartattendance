@model IEnumerable<SmartAttendanceSystem.Properties.Model.Teacher>

@{
    ViewData["Title"] = "Instructors Directory";
    var teachers = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">Faculty Instructors</h2>
            <span class="badge badge-soft-primary badge-pill">@teachers.Count Teachers</span>
        </div>
        <p class="text-muted small mb-0 mt-1">Manage institutional instructors and assigned class cohorts</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Add New Teacher
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header card-header-clean d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0 fw-bold">All Instructors</h5>
        <div class="d-flex align-items-center gap-2">
            <input type="text" id="teacherSearch" class="form-control form-control-sm" placeholder="Search teacher name or email..." style="width: 250px;" />
        </div>
    </div>
    <div class="card-body p-0">
        @if (teachers.Any())
        {
            <div class="table-responsive">
                <table class="table table-modern" id="teachersTable">
                    <thead>
                        <tr>
                            <th>Instructor</th>
                            <th>Email Address</th>
                            <th>Faculty / Department</th>
                            <th>Assigned Class</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in teachers)
                        {
                            var initial = t.Name.Length > 0 ? t.Name.Substring(0, 1).ToUpper() : "T";
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="user-avatar-bubble" style="width: 38px; height: 38px; font-size: 0.85rem;">
                                            @initial
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@t.Name</div>
                                            <small class="text-muted">Username: @(t.User?.UserName ?? "N/A")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">@(t.User?.Email ?? "No email")</span>
                                </td>
                                <td>
                                    <span class="fw-medium text-dark">@(t.Faculty?.Name ?? "—")</span>
                                </td>
                                <td>
                                    <span class="badge badge-soft-dark badge-pill">@(t.SchoolClass?.Name ?? "—")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary" title="Edit Teacher">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete instructor @t.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-video3 fs-1 d-block mb-2"></i>
                <h6>No instructors registered in system yet.</h6>
                <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
                    <i class="bi bi-person-plus-fill"></i> Add First Teacher
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('teacherSearch')?.addEventListener('keyup', function () {
            const query = this.value.toLowerCase();
            const rows = document.querySelectorAll('#teachersTable tbody tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    </script>
}
